generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  role                  Role                @default(CLIENT)
  subscriptionTier      String              @default("free")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  emailVerified         DateTime?
  image                 String?
  name                  String?
  password              String?
  subscriptionCycle     String              @default("monthly")
  subscriptionExpiresAt DateTime?
  address               String?
  phone                 String?
  quotaTier             String              @default("free")
  maxImages             Int                 @default(10)
  maxImageMB            Int                 @default(2)
  maxVideos             Int                 @default(1)
  maxVideoMB            Int                 @default(25)
  maxDocs               Int                 @default(10)
  maxDocMB              Int                 @default(10)
  maxStorageMB          Float               @default(50)
  autoPayEnabled        Boolean             @default(true)
  storagePlanExpiresAt  DateTime?
  storageGraceExpiresAt DateTime?
  storageStatus         String              @default("ACTIVE") // "ACTIVE", "GRACE_PERIOD", "LOCKED"
  lastReminderStage     String?
  accounts              Account[]
  automatixCalendars    AutomatixCalendar[]
  integrations          Integration[]
  Notification          Notification[]
  sessions              Session[]
  workflows             Workflow[]
  supportTickets        SupportTicket[]
  media                 Media[]
  quotaRequests         QuotaRequest[]
  invoices              Invoice[]
  resetEmailCount       Int                 @default(0)
  lastResetEmailAt      DateTime?
  lastPasswordUpdatedAt DateTime?
  maxSupportTickets     Int                 @default(5)
  supportTicketsRemaining Int               @default(5)
  ticketCooldownHours   Int                 @default(24)
  ticketQuotaResetAt    DateTime?
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceName     String   // e.g. "Professional Plan Subscription", "Starter Pack (+100 MB)"
  amountRs        Int      // In INR (₹)
  status          String   @default("PAID") // "PAID", "PENDING", "FAILED"
  paymentMethod   String   @default("UPI / Card")
  billingPeriod   String?  // e.g. "Aug 24, 2026 - Sep 24, 2026"
  paidAt          DateTime? @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Media {
  id          String   @id @default(uuid())
  url         String
  fileName    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String?
  sizeMB      Float
  type        String   @default("IMAGE") // IMAGE, VIDEO, or DOCUMENT
  createdAt   DateTime @default(now())

  @@index([userId])
}

model QuotaRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedPlan String
  message       String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())

  @@index([userId])
}

model StoragePlan {
  id              String   @id @default(uuid())
  name            String
  priceRs         Int
  maxVideos       Int
  maxVideoMB      Int
  maxImages       Int
  maxImageMB      Int
  maxDocs         Int      @default(10)
  maxDocMB        Int      @default(10)
  maxStorageMB    Float    // Total storage limit in MB (e.g., 10000 for 10GB)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Integration {
  id              String            @id @default(uuid())
  clientId        String
  providerName    String
  apiKey          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  name            String            @default("My Connection")
  accountEmail    String            @default("unknown@example.com")
  clientEmail     String?
  privateKey      String?
  ConnectionUsage ConnectionUsage[]
  client          User              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, providerName, accountEmail])
}

model Workflow {
  id            String         @id @default(uuid())
  clientId      String
  name          String
  nodesJson     Json
  isActive      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  executionLogs ExecutionLog[]
  client        User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ExecutionLog {
  id                  String           @id @default(uuid())
  workflowId          String
  externalReferenceId String?
  status              Status           @default(ACTIVE)
  currentNodeState    Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  analyticsEvents     AnalyticsEvent[]
  workflow            Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id             String       @id @default(uuid())
  executionLogId String
  eventType      String
  timestamp      DateTime     @default(now())
  metadata       Json?
  executionLog   ExecutionLog @relation(fields: [executionLogId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AutomatixCalendar {
  id           String   @id @default(uuid())
  clientId     String
  name         String
  internalName String?
  description  String?
  platform     String   @default("gmeet")
  redirectUrl  String?
  themeColor   String   @default("#3B82F6")
  buttonStyle  String   @default("rounded")
  questions    Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logoUrl      String?
  timezone     String?  @default("UTC")
  meetUrl      String?
  sendDefaultEmail Boolean @default(true)
  duration     Int      @default(30)
  bufferBefore Int      @default(0)
  bufferAfter  Int      @default(0)
  futureLimit  Int      @default(30)
  dateRangeType    String   @default("days_in_future")
  futureLimitType  String   @default("calendar_days")
  dateRangeStart   DateTime?
  dateRangeEnd     DateTime?
  noticePeriod     Int      @default(0)
  noticePeriodUnit String   @default("hours")
  slotIncrement    Int      @default(30)
  maxBookingsPerDay Int?
  availability Json?
  emailTemplate Json?
  fontFamily    String?  @default("Plus Jakarta Sans")
  bgTheme       String?  @default("obsidian")
  customBgColor String?
  customCardColor String?
  customTextColor String?
  themeGradient String?
  client       User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookings     AutomatixBooking[]
}

model AutomatixBooking {
  id          String   @id @default(uuid())
  calendarId  String
  name        String
  email       String
  startTime   DateTime
  endTime     DateTime
  timezone    String
  answers     Json?
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  calendar    AutomatixCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

}

model ConnectionUsage {
  id            String      @id
  integrationId String
  date          DateTime    @db.Date
  requestCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, date])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  message   String
  metadata  Json?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("GENERAL") // "REFUND", "CONCIERGE", "GENERAL"
  subject   String
  message   String
  status    String   @default("OPEN")    // "OPEN", "IN_PROGRESS", "RESOLVED", "DISMISSED", "CLOSED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String   // User ID or ADMIN ID
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id                 String   @id @default("default")
  maxUsers           Int      @default(10)
  starterPlanEnabled Boolean  @default(true)
  starterPlanPrice   Int      @default(0)
  starterPlanDesc    String   @default("Perfect for testing and small projects.")
  proPlanEnabled     Boolean  @default(true)
  proPlanPrice       Int      @default(499)
  proPlanDesc        String   @default("For businesses automating at scale.")
  resetEmailTemplate String?  @db.Text
  updatedAt          DateTime @updatedAt
}

model AdminEmailLog {
  id              String   @id @default(uuid())
  category        String   // "ANNOUNCEMENT", "BILLING", "LEGAL", "SYSTEM", "DIRECT"
  subject         String
  body            String   @db.Text
  targetType      String   // "ALL", "PAID", "FREE", "GRACE", "SINGLE"
  recipientEmail  String?  // For single user emails
  sentCount       Int      @default(0)
  sentBy          String   @default("Admin")
  createdAt       DateTime @default(now())
}

enum Role {
  ADMIN
  CLIENT
}

enum Status {
  ACTIVE
  CANCELLED
  COMPLETED
  FAILED
  PARTIALLY_FAILED
  WAITING
}
